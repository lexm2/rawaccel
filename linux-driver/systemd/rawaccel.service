[Unit]
Description=RawAccel Userspace Daemon (Rust)
After=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/local/bin/rawaccel-daemon
Restart=on-failure
RestartSec=5
Environment="RUST_LOG=info"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
