<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:userinterface.ViewModels.Profile"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
			 xmlns:ext="using:userinterface.Extensions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="userinterface.Views.Profile.ProfileChartView"
             x:DataType="vm:ProfileChartViewModel">
	<UserControl.Styles>
		<Style Selector="lvc|CartesianChart">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
			<Setter Property="Margin" Value="8"/>
		</Style>
		<Style Selector="Button.chart-control">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Width" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="4"/>
			<Setter Property="Margin" Value="4"/>
			<Setter Property="Opacity" Value="0.8"/>
		</Style>
		<Style Selector="Button.chart-control:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="ToggleButton.chart-control">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Width" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="4"/>
			<Setter Property="Margin" Value="4"/>
			<Setter Property="Opacity" Value="0.8"/>
		</Style>
		<Style Selector="ToggleButton.chart-control:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="ToggleButton.chart-control:checked">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>
		
		<!-- Animations for smooth transitions -->
		<Style Selector="lvc|CartesianChart.interactive-chart">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
				</Transitions>
			</Setter>
		</Style>
	</UserControl.Styles>
	<Border Background="{DynamicResource HoverBackgroundBrush}"
	        BorderBrush="{DynamicResource BorderBrush}"
	        BorderThickness="1"
	        CornerRadius="8">
		<Grid>
			<!-- Skeleton Loader (shown while chart is initializing) -->
			<Grid IsVisible="{Binding IsLoadingChart}"
			      Background="{DynamicResource ControlBackgroundBrush}"
			      HorizontalAlignment="Stretch"
			      VerticalAlignment="Stretch">

				<!-- Chart outline -->
				<Border BorderBrush="{DynamicResource BorderBrush}"
				        BorderThickness="1"
				        CornerRadius="4"
				        Margin="20"
				        Opacity="0.3">

					<!-- Loading dots -->
					<StackPanel Orientation="Horizontal"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center">
						<Ellipse Width="8" Height="8"
						        Fill="{DynamicResource AccentBrush}"
						        Margin="2"
						        Opacity="0.7"/>
						<Ellipse Width="8" Height="8"
						        Fill="{DynamicResource AccentBrush}"
						        Margin="2"
						        Opacity="0.5"/>
						<Ellipse Width="8" Height="8"
						        Fill="{DynamicResource AccentBrush}"
						        Margin="2"
						        Opacity="0.3"/>
					</StackPanel>
				</Border>
			</Grid>

			<!-- Debug Driver Warning Banner -->
			<Border IsVisible="{Binding IsDebugDriverActive}"
			        Background="#FFF3CD"
			        BorderBrush="#FFC107"
			        BorderThickness="1"
			        CornerRadius="4"
			        Padding="12"
			        Margin="12,12,12,0"
			        VerticalAlignment="Top">
				<StackPanel Spacing="8">
					<TextBlock Text="⚠️ Debug Driver Active"
					           FontWeight="Bold"
					           Foreground="#856404" />
					<TextBlock TextWrapping="Wrap"
					           Foreground="#856404">
						The application is running with DebugDriverService.
						Mouse telemetry and input indicator features will not work.
						To enable real telemetry, unset the RAWACCEL_DEBUG_DRIVER environment variable.
					</TextBlock>
					<TextBlock TextWrapping="Wrap"
					           FontSize="11"
					           Foreground="#856404"
					           FontStyle="Italic">
						Run: unset RAWACCEL_DEBUG_DRIVER &amp;&amp; ./run.sh
					</TextBlock>
				</StackPanel>
			</Border>

			<!-- Interactive Chart (shown after loading) -->
			<lvc:CartesianChart x:Name="Chart"
			                    Classes="interactive-chart"
			                    MinWidth="300"
			                    MinHeight="200"
			                    HorizontalAlignment="Stretch"
			                    VerticalAlignment="Stretch"
			                    SyncContext="{Binding Sync}"
			                    Series="{Binding Series}"
			                    XAxes="{Binding XAxes}"
			                    YAxes="{Binding YAxes}"
			                    TooltipPosition="Top"
			                    TooltipTextPaint="{Binding TooltipTextPaint}"
			                    TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
			                    TooltipTextSize="12"
			                    AutoUpdateEnabled="True"
			                    IsVisible="{Binding IsInteractiveMode}"
			                    Opacity="{Binding ChartOpacity}"/>

			<!-- Overlay Canvas for animated input indicator dots -->
			<Canvas IsVisible="{Binding IsInteractiveMode}">
				<!-- X Curve Dot -->
				<Ellipse x:Name="XCurveDot"
				         Canvas.Left="{Binding XDotPixelX}"
				         Canvas.Top="{Binding XDotPixelY}"
				         Width="12" Height="12"
				         Fill="CornflowerBlue"
				         Stroke="{DynamicResource BorderBrush}"
				         StrokeThickness="2"
				         IsVisible="{Binding ShowInputIndicator}">
					<Ellipse.Transitions>
						<Transitions>
							<DoubleTransition Property="Canvas.Left" Duration="0:0:0.1"/>
							<DoubleTransition Property="Canvas.Top" Duration="0:0:0.05"/>
						</Transitions>
					</Ellipse.Transitions>
				</Ellipse>

				<!-- Y Curve Dot (only visible when YXRatio != 1.0) -->
				<Ellipse x:Name="YCurveDot"
				         Canvas.Left="{Binding YDotPixelX}"
				         Canvas.Top="{Binding YDotPixelY}"
				         Width="12" Height="12"
				         Fill="OrangeRed"
				         Stroke="{DynamicResource BorderBrush}"
				         StrokeThickness="2"
				         IsVisible="{Binding ShowYCurveDot}">
					<Ellipse.Transitions>
						<Transitions>
							<DoubleTransition Property="Canvas.Left" Duration="0:0:0.1"/>
							<DoubleTransition Property="Canvas.Top" Duration="0:0:0.05"/>
						</Transitions>
					</Ellipse.Transitions>
				</Ellipse>
			</Canvas>

			<!-- Chart Controls -->
			<StackPanel Orientation="Horizontal"
			            HorizontalAlignment="Right"
			            VerticalAlignment="Bottom"
			            Margin="16,16,16,2"
			            IsVisible="{Binding IsInteractiveMode}">
				<Button Classes="chart-control"
				        Command="{Binding RecreateAxesCommand}"
				        ToolTip.Tip="{ext:Localized ProfileResetZoom}">
					<PathIcon Data="{StaticResource screenshot_regular}"/>
				</Button>
				<Button Classes="chart-control"
				        Command="{Binding FitToDataCommand}"
				        ToolTip.Tip="{ext:Localized ProfileFitToData}">
					<PathIcon Data="{StaticResource full_screen_zoom_regular}"/>
				</Button>
				<ToggleButton Classes="chart-control"
				              IsChecked="{Binding ShowInputIndicator}"
				              ToolTip.Tip="Show Real-Time Input">
					<Ellipse Width="10" Height="10" Fill="{DynamicResource PrimaryTextBrush}"/>
				</ToggleButton>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
